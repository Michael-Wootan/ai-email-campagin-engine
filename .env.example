# ── Store identity ───────────────────────────────────────────────
STORE_NAME=Acme Store
STORE_URL=https://example.com
RETAIL_PATH=/collections/all
WHOLESALE_PATH=/collections/wholesale
LOGO_URL=
PROMO_PREFIX=ACME

# ── Shopify Admin API ────────────────────────────────────────────
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxx
SHOPIFY_BLOG_ID=
SHOPIFY_BLOG_HANDLE=news

# ── MailerLite ───────────────────────────────────────────────────
MAILERLITE_API_KEY=your-mailerlite-api-key
MAILERLITE_RETAIL_GROUP_ID=000000000000000000
MAILERLITE_WHOLESALE_GROUP_ID=000000000000000000
MAILERLITE_INTERNATIONAL_GROUP_ID=
FROM_NAME=Acme Store
FROM_EMAIL=marketing@example.com

# ── AI ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-6
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Owner approval mailbox (sends previews, reads HOLD/REDO replies) ──
OWNER_EMAIL=owner@example.com
MAIL_USER=automation@example.com
MAIL_APP_PASSWORD=app-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
IMAP_HOST=imap.example.com

# ── Optional aggregate rating (used only if config/reviews.json has none) ──
REVIEW_RATING=
REVIEW_COUNT=
REVIEW_SOURCE=
REVIEW_PROFILE_URL=

# ── Optional behaviour ───────────────────────────────────────────
# Comma-separated Google News queries for the (rare) news-angle email
NEWS_QUERIES=wellness industry news,botanical market trends
# Regex: which products may be marketed to the international segment / lead it
EXPORT_ELIGIBLE_PATTERN=\bexport\b
INTERNATIONAL_HERO_PATTERN=\bbulk\b
# Regex of hosts the link checker should skip (e.g. a review profile that blocks datacenter IPs)
LINK_CHECK_SKIP=
CONFIG_DIR=
STATE_DIR=
